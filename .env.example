# Optional reminder provider credentials. Copy this file to .env and fill in only
# the providers you want. Never commit .env or share it in backups.
# Email setup: https://resend.com/docs/api-reference/emails/send-email
RESEND_API_KEY=
REMINDER_EMAIL_FROM=
# SMS setup: https://www.twilio.com/docs/messaging/api/message-resource
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Advanced: keep this stable. Changing the port creates a separate browser
# storage location. Export a case backup before changing it.
# KARENS_LOAD_PORT=47831
