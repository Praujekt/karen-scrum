{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weekwise-reminders",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "observability": { "enabled": false },
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "ALLOWED_ORIGIN": "https://praujekt.github.io",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "weekwise-reminders",
      "database_id": "REPLACE-WITH-THE-ID-RETURNED-BY-WRANGLER",
    },
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "weekwise-encrypted-files",
    },
  ],
}
